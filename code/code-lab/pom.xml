<?xml version="1.0" encoding="UTF-8"?>
<!-- Aggregator for the Code Lab's Maven builds. Labs 10, 11, 15, 16, 17 and 20 are plain Java and scripts, run with
     their own run.sh; they have no Maven module. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.foodfleet.handbook</groupId>
        <artifactId>handbook-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>code-lab</artifactId>
    <packaging>pom</packaging>
    <name>Microservices Handbook :: Code Lab</name>

    <modules>
        <module>lab-01-hello-microservice</module>
        <module>lab-02-persistence</module>
        <module>lab-03-two-services</module>
        <module>lab-04-discovery-gateway</module>
        <module>lab-05-config-vault</module>
        <module>lab-06-resilience</module>
        <module>lab-07-kafka</module>
        <module>lab-08-oauth2-keycloak</module>
        <module>lab-09-outbox-cdc</module>
        <module>lab-12-observability</module>
        <module>lab-13-redis</module>
        <module>lab-14-virtual-threads-vs-webflux</module>
        <module>lab-18-multi-tenancy</module>
        <module>lab-19-contracts-archunit</module>
    </modules>
</project>
