{
  "realm": "foodfleet",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "CUSTOMER",
        "description": "Orders food"
      },
      {
        "name": "RESTAURANT_OWNER",
        "description": "Manages a restaurant's orders and menu"
      },
      {
        "name": "RIDER",
        "description": "Delivers orders"
      },
      {
        "name": "SUPPORT",
        "description": "Customer support: reads orders, issues refunds"
      },
      {
        "name": "ADMIN",
        "description": "Platform administration"
      }
    ]
  },
  "clientScopes": [
    {
      "name": "orders:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "audience order-service",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "order-service",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "orders:write",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "audience order-service",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "order-service",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "payments:capture",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience payment-service",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "payment-service",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "customer-app",
      "name": "FoodFleet customer app",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "foodfleet://callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "profile",
        "roles",
        "orders:read"
      ],
      "optionalClientScopes": [
        "orders:write",
        "payments:capture"
      ]
    },
    {
      "clientId": "order-service",
      "name": "order-service (token exchange, service account)",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {
        "standard.token.exchange.enabled": "true"
      },
      "defaultClientScopes": [],
      "optionalClientScopes": [
        "payments:capture"
      ]
    },
    {
      "clientId": "lab-tester",
      "name": "LAB ONLY: password grant for curl. Never in a real realm (ADR-037).",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": [
        "profile",
        "roles",
        "orders:read"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "id": "customer-asha",
      "username": "asha",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Asha",
      "lastName": "Lab",
      "email": "asha@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "lab-only",
          "temporary": false
        }
      ],
      "realmRoles": [
        "CUSTOMER"
      ]
    },
    {
      "id": "customer-ravi",
      "username": "ravi",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Ravi",
      "lastName": "Lab",
      "email": "ravi@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "lab-only",
          "temporary": false
        }
      ],
      "realmRoles": [
        "CUSTOMER"
      ]
    },
    {
      "id": "agent-7",
      "username": "agent7",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Agent",
      "lastName": "Seven",
      "email": "agent7@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "lab-only",
          "temporary": false
        }
      ],
      "realmRoles": [
        "SUPPORT"
      ]
    }
  ]
}