<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 25 — Asynchronous Messaging: consumers of FoodFleet's order-events topic.
    sim/    delivery semantics (when to commit), ordering vs parallelism in a partition, and five
            retry / dead-letter strategies through a poison message and a dependency outage
    kafka/  Spring for Apache Kafka: an ordered consumer with blocking retries + DLT and
            not-retryable classification, a non-blocking @RetryableTopic consumer with @DltHandler,
            idempotent handling; tested against an embedded broker
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.foodfleet.handbook</groupId>
        <artifactId>chapters</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ch25-messaging</artifactId>
    <name>Ch25 :: Asynchronous Messaging</name>

    <dependencies>
        <!-- Spring for Apache Kafka (listener containers, error handlers, retry topics) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jackson</artifactId>
        </dependency>

        <!-- spring-kafka-test: an embedded KRaft broker for @EmbeddedKafka tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
