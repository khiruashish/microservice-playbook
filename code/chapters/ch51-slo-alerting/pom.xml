<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 51 — SLIs, SLOs, Error Budgets & Alerting.
    slo/        Slo (objective, window, error budget), BurnRateAlert (the SRE workbook's multi-window, multi-burn-rate
                conditions, scaled to any window) and ErrorBudget (spent, remaining, time to exhaustion, policy)
    rules/      PrometheusSloRules (recording and alerting rules for any SLO, like Sloth or Pyrra) and CheckoutSlos
                (FoodFleet's checkout availability and latency SLOs)
    resources/  prometheus/checkout-slo.rules.yml (generated), alertmanager/alertmanager.yml (page, ticket, inhibition),
                application.yml (a histogram bucket at the latency objective)
  verify/run.sh replays incidents through Prometheus 3.15.0's rule engine for five alerting strategies, reads a latency
  SLI from Micrometer histograms, and runs the routing on Alertmanager 0.34.1.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.foodfleet.handbook</groupId>
        <artifactId>chapters</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ch51-slo-alerting</artifactId>
    <name>Ch51 :: SLIs, SLOs, Error Budgets &amp; Alerting</name>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
