    </parent>

    <artifactId>ch20-anti-patterns</artifactId>
    <name>Ch20 :: Microservice Anti-Patterns</name>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
