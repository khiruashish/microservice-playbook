# FoodFleet, 2024: nine services by business capability ("decomposition B", chapter 6),
# after the migration and the fixes in chapters 12-19.
system foodfleet-2024-capabilities

service ordering        team=orders    endpoints=18 loc=46000
service customer        team=growth    endpoints=8  loc=12000
service catalog         team=catalog   endpoints=16 loc=31000
service kitchen         team=kitchen   endpoints=8  loc=19000
service delivery-zones  team=logistics endpoints=4  loc=6100
service delivery        team=logistics endpoints=9  loc=27000
service promotions      team=growth    endpoints=6  loc=9500
service notification    team=platform  endpoints=4  loc=7200
service payment         team=payments  endpoints=11 loc=24000

# place order: menu data is a local replica (ADR-019), so catalog is not on the order path
call ordering -> customer        per-request=1 sync
call ordering -> delivery-zones  per-request=1 sync
call ordering -> promotions      per-request=1 sync
call ordering -> payment         per-request=1 sync
call ordering -> kitchen         per-request=1 async
call ordering -> notification    per-request=1 async
call ordering -> delivery        per-request=1 async
# browse menu
call catalog -> delivery-zones   per-request=1 sync

table orders    owner=ordering
table customers owner=customer readers=promotions
table menu      owner=catalog
table zones     owner=delivery-zones

library foodfleet-platform kind=utility ordering=4.1.0 customer=4.1.0 catalog=4.1.0 kitchen=4.0.3 delivery-zones=4.1.0 delivery=4.1.0 promotions=4.1.0 notification=4.0.3 payment=4.1.0

deploy 2024-09-02T00:00 payment
deploy 2024-09-03T05:00 catalog
deploy 2024-09-03T16:00 payment
deploy 2024-09-04T01:00 delivery-zones
