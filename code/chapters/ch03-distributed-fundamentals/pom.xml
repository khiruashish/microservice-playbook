<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 3 — Distributed Systems Fundamentals.
    net/          a deterministic unreliable network (drops, duplicates, delays, reordering)
    clock/        Lamport, vector and hybrid logical clocks
    replication/  a quorum-replicated register: stale reads, R + W > N, CP vs AP under partition
    idempotency/  idempotent consumer + Idempotency-Key executor ("exactly-once effects")
    refund/       a Spring Boot 4 endpoint applying Idempotency-Key to FoodFleet refunds
  Everything except refund/ is plain Java 21 with no framework, so the ideas stay visible.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.foodfleet.handbook</groupId>
        <artifactId>chapters</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ch03-distributed-fundamentals</artifactId>
    <name>Ch03 :: Distributed Systems Fundamentals</name>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
