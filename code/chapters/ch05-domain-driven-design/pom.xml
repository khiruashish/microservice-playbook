<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 5 — Domain-Driven Design: FoodFleet's Ordering bounded context.
    ordering/domain          pure Java: value objects, Order aggregate, events, PricingPolicy, ports
    ordering/application     pure Java: OrderApplicationService (use cases)
    ordering/infrastructure  adapters: anti-corruption layer to Catalog, repository, Spring wiring
    ordering/api             REST adapter
    catalog                  the upstream Catalog context's published API (simulated in-process)
  ArchitectureTest keeps domain and application free of Spring and infrastructure.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.foodfleet.handbook</groupId>
        <artifactId>chapters</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ch05-domain-driven-design</artifactId>
    <name>Ch05 :: Domain-Driven Design (Ordering context)</name>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
