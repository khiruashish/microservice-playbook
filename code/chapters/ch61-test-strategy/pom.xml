<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 61 — Test Strategy: Pyramid vs Honeycomb.
    order/       order-service in plain Java: Pricing (FIRST20, GST, minimum order), OrderService, JdbcOrderRepository
                 (idempotent insert with ON CONFLICT), HttpMenuClient, OrderApi
    test/        five suites, selected by JUnit tag: unit, h2, postgres, contract, component
  verify/run.sh compiles 20 realistic bugs into the service one at a time and records which suites catch each.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.foodfleet.handbook</groupId>
        <artifactId>chapters</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ch61-test-strategy</artifactId>
    <name>Ch61 :: Test Strategy: Pyramid vs Honeycomb</name>

    <dependencies>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- mvn test -Dgroups=unit, or 'unit | component'; postgres needs -Dff.pg.url -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <user.timezone>UTC</user.timezone>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
