<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 14 — Saga Pattern: FoodFleet place-order saga.
    saga/          a small orchestration engine: step kinds (compensatable, pivot, retriable), a saga log,
                   crash recovery by resuming from the log
    placeorder/    the saga and its participants (coupon, payment, kitchen, delivery, order), with
                   idempotency keys and failure injection
    choreography/  the same flow as events between services, for comparison
    simulation/    10,000 sagas with injected failures and crashes: outcomes, compensations, double charges
  Plain Java; Spring Boot's test starter only for JUnit and AssertJ.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.foodfleet.handbook</groupId>
        <artifactId>chapters</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ch14-saga</artifactId>
    <name>Ch14 :: Saga Pattern (place order)</name>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
