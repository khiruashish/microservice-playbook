<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 63 — Contract Testing.
    contract/   Contract (Pact v3 files), Matching (Pact's rules: type, min, regex, unexpected keys allowed), Verifier
                (provider verification), StubServer (the consumer's stub)
    openapi/    SchemaDiff: oasdiff's breaking-change rules for the parts menu-service uses
    menu/       menu-service, the provider; consumer/ order-service's and app-bff's clients
  verify/run.sh applies 12 provider changes and 5 data changes and compares an OpenAPI diff, two consumers'
  contracts (three ways of writing them) and an E2E suite with what actually breaks.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.foodfleet.handbook</groupId>
        <artifactId>chapters</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ch63-contract-testing</artifactId>
    <name>Ch63 :: Contract Testing</name>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
