# JDK 25's AOT cache (JEPs 483, 514, 515): one training run records loaded and linked classes and method profiles.
FROM c60/jre:25
COPY --chown=10001:10001 app/ /app/
RUN ["java", "-XX:AOTCacheOutput=/app/app.aot", "-cp", "/app/*", "Trainer"]
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-XX:AOTCache=/app/app.aot", "-cp", "/app/*", "StartupLab"]
