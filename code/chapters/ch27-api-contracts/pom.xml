<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 27 — API Contracts & Schema Evolution: order-service's Order API and its consumers.
    compat/    a year of changes to GET /orders/{id} against five consumers: what actually breaks,
               what a structural diff reports, what consumer-driven contracts catch
    api/       the provider: OpenAPI 3.1 and AsyncAPI 3.0 documents (static/contracts), a spec-drift
               test, and Spring Cloud Contract tests generated from consumers' contracts
    consumer/  a tolerant reader with Jackson 3 (unknown fields ignored, unknown enum values mapped)
    verify/    validates the documents with the official JSON Schemas, and real responses against them
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.foodfleet.handbook</groupId>
        <artifactId>chapters</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ch27-api-contracts</artifactId>
    <name>Ch27 :: API Contracts &amp; Schema Evolution</name>

    <properties>
        <!-- Spring Cloud 2025.1.2 ships Spring Cloud Contract 5.0.3; plugins aren't managed by the BOM -->
        <spring-cloud-contract.version>5.0.3</spring-cloud-contract.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Contract verifier: generated provider tests (MockMvc + RestAssured), stubs jar for consumers -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-contract-verifier</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-contract-maven-plugin</artifactId>
                <version>${spring-cloud-contract.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <!-- contracts in src/test/resources/contracts; JUnit 5 and MockMvc are the defaults -->
                    <baseClassForTests>dev.foodfleet.ch27.api.ContractVerifierBase</baseClassForTests>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
