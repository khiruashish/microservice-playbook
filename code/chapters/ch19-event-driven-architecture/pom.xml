<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 19 — Event-Driven Architecture: three integration styles for menu data, measured.
    catalog/, bus/, consumer/, sim/   catalog-service, a keyed at-least-once topic, notification and
                                      state-transfer consumers, a version-checked replica
    simulation/                       a 10-minute lunch rush with a catalog outage, four styles compared,
                                      and what a new consumer must read to bootstrap
    app/                              Spring Cloud Stream: StreamBridge publisher keyed by item id, a
                                      functional Consumer bean, local replica, test binder tests
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.foodfleet.handbook</groupId>
        <artifactId>chapters</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ch19-event-driven-architecture</artifactId>
    <name>Ch19 :: Event-Driven Architecture</name>

    <dependencies>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-stream-binder-kafka</artifactId>
        </dependency>
        <!-- Boot 4: Jackson 3 for (de)serializing event payloads -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jackson</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- in-memory binder: bindings and serialization without a Kafka broker -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-stream-test-binder</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
