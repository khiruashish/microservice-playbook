         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.foodfleet.handbook</groupId>
        <artifactId>chapters</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ch47-observability-fundamentals</artifactId>
    <name>Ch47 :: Observability Fundamentals</name>

    <!-- The signal model needs only the JDK; the agent, Collector and Prometheus run as their own processes. -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
