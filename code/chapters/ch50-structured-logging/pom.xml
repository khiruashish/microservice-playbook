<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 50 — Structured Logging & Correlation.
    masking/    Masker (one pass over a line: e-mail and UPI addresses, Indian mobile numbers, Luhn-valid card numbers,
                JWTs and bearer tokens), Pii (values that mask themselves) and MaskingEncoder (wraps any Logback encoder)
    mdc/        RequestMdc (request fields in the MDC for exactly the request's lifetime), MdcPropagation and
                MdcTaskDecorator (the MDC across thread hand-offs, restoring the worker's own afterwards)
    resources/  application.yml (Spring Boot 4 ECS structured logging) and logback-spring.xml (ECS behind a masking
                encoder and an AsyncAppender that neither drops INFO nor loses events)
  verify/run.sh measures, on Logback 1.5.38 and the OpenTelemetry Java agent 2.32.0: request and trace IDs across nine
  thread hand-offs, AsyncAppender under a burst, the cost of JSON and masking, and where personal data leaks.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.foodfleet.handbook</groupId>
        <artifactId>chapters</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ch50-structured-logging</artifactId>
    <name>Ch50 :: Structured Logging &amp; Correlation</name>

    <dependencies>
        <!-- Logback and SLF4J, the versions Spring Boot manages -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-logging</artifactId>
        </dependency>
        <!-- TaskDecorator -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
