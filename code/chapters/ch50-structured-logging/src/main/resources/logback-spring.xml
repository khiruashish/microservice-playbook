<?xml version="1.0" encoding="UTF-8"?>
<!--
  For services that need more than the properties: Spring Boot's ECS structured encoder behind an AsyncAppender, so a
  slow stdout or disk doesn't slow requests, and the masking net over the finished line, with the settings measured in chapter 50:
    discardingThreshold 0   never drop INFO silently (Logback's default drops TRACE-INFO when the queue is 80% full)
    neverBlock false        block callers rather than lose events when the queue is full
    queueSize 8192          absorb bursts
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <springProperty name="appName" source="spring.application.name"/>

    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <!-- MaskingEncoder masks the finished line, whatever field the personal data ended up in -->
        <encoder class="dev.foodfleet.ch50.masking.MaskingEncoder">
            <delegate class="org.springframework.boot.logging.logback.StructuredLogEncoder">
                <format>ecs</format>
                <charset>UTF-8</charset>
            </delegate>
        </encoder>
    </appender>

    <appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>8192</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>false</neverBlock>
        <includeCallerData>false</includeCallerData>
        <appender-ref ref="JSON"/>
    </appender>

    <root level="INFO">
        <appender-ref ref="ASYNC"/>
    </root>
</configuration>
