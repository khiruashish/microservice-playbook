<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 41 — Supply-Chain Security & Compliance.
    sbom/     Component (package URLs) and CycloneDx (components of a CycloneDX JSON SBOM, nested ones included)
    vuln/     MavenVersion (Maven's version order), Advisory and OsvDatabase (OSV advisories, e.g. the GitHub Advisory
              Database), Scanner (SBOM x advisories, optionally "as known on date X") and Gate (the CI rule, with
              dated waivers)
    privacy/  CryptoShredder: per-customer data keys, so erasure reaches backups and event logs
  resources/ holds the release workflow (ci/), the Maven supply-chain settings (maven/), Kyverno's image verification
  policy (kyverno/), OPA deployment rules with tests (policy/), sample manifests (k8s/), the cosign provenance
  policy and predicates (cosign/) and order-service's SBOM endpoint configuration. verify/run.sh verifies release
  signatures, builds SBOMs of four Keycloak releases with Syft, scans them, signs and attests an image in a local
  registry, evaluates the policies and measures crypto-shredding.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.foodfleet.handbook</groupId>
        <artifactId>chapters</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ch41-supply-chain-compliance</artifactId>
    <name>Ch41 :: Supply-Chain Security &amp; Compliance</name>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- this module's own SBOM: target/classes/META-INF/sbom/application.cdx.json (configured by the Boot parent) -->
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
