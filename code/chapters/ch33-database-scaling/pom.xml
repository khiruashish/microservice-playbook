<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 33 — Database Scaling & Zero-Downtime Migrations.
    address/   renaming customers.address to delivery_address with expand/contract: phases, dual writes,
               a keyset backfill in small committed batches
    pool/      sizing HikariCP pools against the database's connection limit
    sharding/  a fixed set of slots mapped to shards, and the minimal moves when shards are added
    db/        Flyway migrations written for a busy database: lock_timeout, CREATE INDEX CONCURRENTLY on its own,
               NOT VALID constraints validated in a separate migration; db/later holds the contract step
    verify/    the chapter's experiments (pgbench and python3)
-->
