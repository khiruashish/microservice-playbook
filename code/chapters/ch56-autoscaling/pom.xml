        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ch56-autoscaling</artifactId>
    <name>Ch56 :: Autoscaling</name>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
