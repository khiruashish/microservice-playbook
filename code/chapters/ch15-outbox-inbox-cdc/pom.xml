<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 15 — Transactional Outbox, Inbox & CDC.
    sim/, orders/      a service database (atomic local transactions + write-ahead log), a broker with
                       at-least-once delivery, and seeded fault injection
    dualwrite/         the bug: write to the database and the broker separately
    outbox/            the fix: outbox written in the business transaction; polling publisher and
                       log-tailing (CDC) relays
    inbox/             consumer-side deduplication in the consumer's own transaction
    simulation/        10,000 orders through five designs with the same faults
    app/               the same on Spring Boot 4 + PostgreSQL: JdbcClient outbox, SKIP LOCKED relay, inbox
  debezium/ holds the Kafka Connect configuration for the CDC relay (Outbox Event Router).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.foodfleet.handbook</groupId>
        <artifactId>chapters</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ch15-outbox-inbox-cdc</artifactId>
    <name>Ch15 :: Transactional Outbox, Inbox &amp; CDC</name>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- Boot 4: Jackson 3 (tools.jackson) has its own starter; provides the JsonMapper bean -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
