<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 43 — Resilience4j & Spring Framework 7 Resilience.
    policy/  FoodFleet's Resilience4j configuration (ResiliencePolicies), a pipeline composed in Spring Boot's aspect
             order (Resilient), and the retry predicate that looks through cause chains (Transient)
    web/     order-service: MenuClient with @Retry/@CircuitBreaker/@Bulkhead and a cached fallback; PaymentClient with
             Spring Framework 7's @Retryable and @ConcurrencyLimit; RestClients that map 4xx to ClientErrorException
  verify/run.sh builds Resilience4j 2.4.0 and Spring Framework 7.0.9's retry classes from their tags and measures
  breaker windows, slow calls, TimeLimiter cancellation, decorator order, rate limiting, retry schedules, overload
  and overhead.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.foodfleet.handbook</groupId>
        <artifactId>chapters</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ch43-resilience4j</artifactId>
    <name>Ch43 :: Resilience4j &amp; Spring Framework 7 Resilience</name>

    <properties>
        <!-- Spring Cloud 2025.1.2 manages 2.3.0, which has no Spring Boot 4 module; this import wins over it -->
        <resilience4j.version>2.4.0</resilience4j.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bom</artifactId>
                <version>${resilience4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- the annotations are applied by aspects: Boot 4's starter for AspectJ (spring-boot-starter-aop before 4.0) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>
        <!-- the 2.4.0 BOM lists resilience4j-spring-boot3 but not -spring-boot4: the version must be given here -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot4</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-micrometer</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
