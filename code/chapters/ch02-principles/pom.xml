<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chapter 2 — Characteristics & Principles, shown in one FoodFleet service (menu-service):
    single responsibility · API-first with built-in API versioning · tolerant reader ·
    design for failure (timeouts, @Retryable, @ConcurrencyLimit, last-known-good fallback) ·
    externalized config · principles enforced as ArchUnit fitness functions
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.foodfleet.handbook</groupId>
        <artifactId>chapters</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>ch02-principles</artifactId>
    <name>Ch02 :: Principles in a Menu Service</name>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- Boot 4: RestClient and HTTP service clients (@ImportHttpServices, spring.http.serviceclient.*)
             live in their own module. Tests pass without it (the webmvc test starter pulls it in),
             but the app fails at runtime, so declare it explicitly. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
